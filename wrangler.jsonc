{
  "name": "nuxt-starter",
  "main": "lib/db/index.ts",
  "compatibility_date": "2024-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test-db",
      "database_id": "YOUR_DB_ID",
      "migrations_dir": "lib/db/migrations"
    }
  ]
}
